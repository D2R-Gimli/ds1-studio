{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS1 Studio",
  "version": "0.2.63",
  "identifier": "com.ds1studio.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DS1 Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "RoofooEvazan",
    "homepage": "https://github.com/RoofooEvazan/ds1-studio",
    "category": "DeveloperTool",
    "shortDescription": "Map editor for Diablo II DS1/DT1 files",
    "longDescription": "DS1 Studio is a modern map editor for classic Diablo II (1.13/1.14) DS1 map presets and DT1 tile libraries.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OTY1MjM4MzY3MEUwREIKUldUYjRIQTJPRktXaENOOTJoblZJYlN2SSs1d0tvd29JRFVod1greWJLSWhxQkNVT3VBelVxbCsK",
      "endpoints": [
        "https://github.com/RoofooEvazan/ds1-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
